// ─────────────────────────────────────────────────────────────────────────────
// AssessIQ — Prisma Schema
// All tables are scoped by organizationId for multi-tenancy.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum OrgType {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  UNIVERSITY
  TUTORIAL_CENTER
  TRAINING_INSTITUTION
  EXAM_BODY
  OTHER
}

enum SubscriptionPlan {
  FREE_TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  THEORY
  TRUE_FALSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
  ABANDONED
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  PPTX
  TXT
}

enum IntegrityEventType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  DEV_TOOLS_OPEN
  IDLE_WARNING
}

enum IntegritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AIAction {
  GENERATE_QUESTIONS
  GENERATE_SUMMARY
  GENERATE_FLASHCARDS
  EXTRACT_TOPICS
  REVIEW_QUALITY
  WEAK_TOPIC_SUGGESTION
  ANSWER_QUESTION
  EMBED_CONTENT
  RECOMMEND_RESOURCES
  EXTRACT_TIMETABLE
  CHAT
  GENERATE_LESSON
  GRADE_ANSWERS
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum PlanType {
  EXAM_DATE
  DURATION
}

enum SessionKind {
  LEARN
  REVIEW
  REVISION
}

enum StudySessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
}

enum Semester {
  FIRST
  SECOND
}

enum TopicSource {
  OUTLINE
  MATERIAL
  AI_SUGGESTED
  AI_EXPANDED
  STUDENT
}

enum LessonMode {
  MATERIAL
  AI
  COMBINED
}

enum OutlineSource {
  UPLOAD
  PASTE
  PHOTO
}

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
  SECONDARY_SCHOOL
  OTHER
}

enum GpaScale {
  FIVE
  FOUR
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  joinCode     String           @unique
  type         OrgType
  plan         SubscriptionPlan @default(FREE_TRIAL)
  trialEndDate DateTime?
  logoUrl      String?
  website      String?
  address      String?
  country      String           @default("Nigeria")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  users        User[]
  courses      Course[]
  questions    Question[]
  assessments  Assessment[]
  documents    Document[]
  aiUsageLogs  AIUsageLog[]
  flashcards   Flashcard[]

  @@index([slug])
  @@map("organizations")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organizationId String?
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole
  status         UserStatus   @default(PENDING)
  avatarUrl      String?
  // Academic profile (Nightklass onboarding) — drives course suggestions and personalisation
  country          String?
  institutionType  InstitutionType?
  programme        String?
  currentLevel     Int?
  currentSemester  Semester?
  institution      String?
  faculty          String?
  academicSession  String?
  graduationYear   Int?
  studyPathway    StudyPathway @default(TERTIARY)
  secondaryStage  SecondaryStage?
  examGoals       ExamGoal[]
  examMockAttempts ExamMockAttempt[]
  syllabusStudyLinks ExamObjectiveStudyLink[]
  profileCompletedAt DateTime?
  emailVerifiedAt DateTime?
  // Which privacy notice the learner acknowledged at sign-up, and when.
  privacyNoticeVersion String?
  privacyAcceptedAt DateTime?
  // Incremented to revoke every issued access token (password reset, deletion).
  sessionVersion Int @default(0)
  deletedAt      DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teacherCourses Course[]      @relation("CourseTeacher")
  ownedCourses   Course[]      @relation("CourseOwner")
  uploadedDocs   Document[]    @relation("DocumentUploader")
  createdQuestions Question[]  @relation("QuestionCreator")
  createdAssessments Assessment[] @relation("AssessmentCreator")
  attempts       Attempt[]
  aiUsageLogs    AIUsageLog[]
  flashcards     Flashcard[]
  refreshTokens  RefreshToken[]
  studyAvailabilities StudyAvailability[] @relation("StudyAvailabilityStudent")
  studyPlans     StudyPlan[]   @relation("StudyPlanStudent")
  studySessions  StudySession[] @relation("StudySessionStudent")
  topicMasteries TopicMastery[] @relation("TopicMasteryStudent")
  gpaEntries     GpaEntry[]    @relation("GpaEntryStudent")
  nightklassAdmin NightklassAdmin?
  adminAuditLogs NightklassAdminAudit[]
  emailTokens    EmailToken[]
  examCohort     ExamCohortMember?
  questionExposures ExamQuestionExposure[]
  questionReports ExamQuestionReport[]

  @@index([organizationId])
  @@index([email])
  @@index([role, organizationId, createdAt])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  // SHA-256 of the issued token; the raw value is never stored.
  token     String   @unique
  // Rotations share a family so reuse of a rotated token revokes the whole chain.
  // Defaulted so a previous API version, still serving during a rollout, can keep issuing tokens.
  familyId  String   @default(dbgenerated("(gen_random_uuid())::text"))
  rotatedAt DateTime?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Course ───────────────────────────────────────────────────────────────────

// A Course is either organisation-owned (organizationId + teacherId set — taught by a
// teacher to an org's students) or personally-owned (ownerId set — a student's own
// self-study course, e.g. a Nightklass user with no organisation at all). Exactly one
// of (organizationId + teacherId) or ownerId is expected to be set.
model Course {
  id             String       @id @default(cuid())
  organizationId String?
  teacherId      String?
  ownerId        String?
  title          String
  subject        String
  description    String?
  courseCode     String?
  level          Int?
  semester       Semester?
  creditUnits    Int?
  isCarryover    Boolean      @default(false)
  targetExamDate DateTime?    @db.Date
  examSubjectKey String?
  examGoalSubjects ExamGoalSubject[]
  // The original course outline exactly as provided (uploaded, pasted or photographed), never modified by AI
  outlineText    String?      @db.Text
  outlineSource  OutlineSource?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher        User?        @relation("CourseTeacher", fields: [teacherId], references: [id])
  owner          User?        @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  topics         Topic[]
  documents      Document[]
  questions      Question[]
  assessments    Assessment[]
  studyPlans     StudyPlan[]
  studySessions  StudySession[]
  flashcards     Flashcard[]
  outlineRevisions OutlineRevision[]

  @@index([organizationId])
  @@index([teacherId])
  @@index([ownerId])
  @@unique([ownerId, examSubjectKey])
  @@map("courses")
}

// ─── Topic ────────────────────────────────────────────────────────────────────

model Topic {
  syllabusStudyLinks ExamObjectiveStudyLink[]
  id                String    @id @default(cuid())
  courseId          String
  name              String
  description       String?
  parentTopicId     String?
  order             Int       @default(0)
  estimatedMinutes  Int?
  importanceWeight  Float?
  // Cached external resources (e.g. YouTube results) so we don't spend API quota on every view
  resources         Json?
  resourcesFetchedAt DateTime?
  // Which outline layer this topic belongs to (OUTLINE = the student's/lecturer's original; AI_* = Nightklass enrichment)
  source            TopicSource @default(STUDENT)
  // Archived instead of deleted when it has study progress, so edits never destroy history
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())

  // Relations
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentTopic   Topic?    @relation("TopicHierarchy", fields: [parentTopicId], references: [id])
  subTopics     Topic[]   @relation("TopicHierarchy")
  questions     Question[]
  studySessions StudySession[]
  masteries     TopicMastery[]
  flashcards    Flashcard[]
  lessons       TopicLesson[]
  chunks        DocumentChunk[]

  @@index([courseId])
  @@map("topics")
}

// ─── Outline revision ─────────────────────────────────────────────────────────
// Snapshot of a course's topic tree after each structural change (syllabus versioning)

model OutlineRevision {
  id          String   @id @default(cuid())
  courseId    String
  createdById String
  reason      String
  snapshot    Json
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("outline_revisions")
}

// ─── Document chunks (retrieval) ──────────────────────────────────────────────
// Uploaded material split into passages with embeddings, so generation pulls the relevant parts

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String
  courseId    String
  index       Int
  text        String   @db.Text
  embedding   Float[]
  // The course topic this passage best matches (set when the document is mapped to the outline)
  topicId     String?
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([documentId])
  @@map("document_chunks")
}

// ─── Lessons (generated learning content) ─────────────────────────────────────
// Each regeneration adds a version; sources record exactly which passages grounded it

model TopicLesson {
  id                String     @id @default(cuid())
  topicId           String
  version           Int
  mode              LessonMode
  content           Json
  sourceChunkIds    String[]
  sourceDocumentIds String[]
  model             String?
  feedback          String?    @db.Text
  createdById       String
  createdAt         DateTime   @default(now())

  topic             Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reports           ContentReport[]

  @@unique([topicId, version])
  @@map("topic_lessons")
}

model ContentReport {
  id        String      @id @default(cuid())
  lessonId  String
  userId    String
  reason    String      @db.Text
  createdAt DateTime    @default(now())
  status    String      @default("OPEN")
  resolution String?    @db.Text
  resolvedAt DateTime?
  resolvedById String?

  lesson    TopicLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([status, createdAt])
  @@map("content_reports")
}

// ─── Document ─────────────────────────────────────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  organizationId String?
  uploadedById   String
  courseId       String?
  fileName       String
  fileType       DocumentType
  fileUrl        String
  fileSizeBytes  Int
  status         DocumentStatus @default(UPLOADING)
  extractedText  String?        @db.Text
  pageCount      Int?
  chunkCount     Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  generatedQuestions Question[]
  flashcards     Flashcard[]
  chunks         DocumentChunk[]

  @@index([organizationId])
  @@index([uploadedById])
  @@map("documents")
}

// ─── Question ─────────────────────────────────────────────────────────────────

model Question {
  sourceExamBankQuestionId String?
  sourceExamBankQuestion ExamBankQuestion? @relation(fields: [sourceExamBankQuestionId], references: [id], onDelete: SetNull)
  id               String             @id @default(cuid())
  organizationId   String?
  createdById      String
  topicId          String?
  courseId         String?
  sourceDocumentId String?
  questionText     String             @db.Text
  questionType     QuestionType
  options          Json?              // Array of { key, text } for MCQ
  correctAnswer    String             @db.Text
  explanation      String?            @db.Text
  difficulty       QuestionDifficulty
  bloomLevel       BloomLevel?
  status           QuestionStatus     @default(DRAFT)
  isAiGenerated    Boolean            @default(false)
  marks            Int?               // structured/essay questions: marks available
  aiGenerationId   String?            // AIUsageLog.id
  tags             String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  organization     Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User               @relation("QuestionCreator", fields: [createdById], references: [id])
  topic            Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sourceDocument   Document?          @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  assessmentLinks  AssessmentQuestion[]
  answers          Answer[]

  @@index([organizationId])
  @@index([courseId])
  @@index([topicId])
  @@index([status])
  @@map("questions")
}

// ─── Assessment ───────────────────────────────────────────────────────────────

model Assessment {
  id              String           @id @default(cuid())
  organizationId  String
  courseId        String
  createdById     String
  title           String
  description     String?
  instructions    String?          @db.Text
  durationMinutes Int
  status          AssessmentStatus @default(DRAFT)
  startTime       DateTime?
  endTime         DateTime?
  settings        Json             // AssessmentSettings object
  totalQuestions  Int              @default(0)
  totalMarks      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id])
  createdBy       User             @relation("AssessmentCreator", fields: [createdById], references: [id])
  questions       AssessmentQuestion[]
  attempts        Attempt[]

  @@index([organizationId])
  @@index([courseId])
  @@index([status])
  @@map("assessments")
}

// ─── Assessment ↔ Question (join table) ──────────────────────────────────────

model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  questionId   String
  order        Int
  scoreWeight  Float      @default(1)

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_questions")
}

// ─── Attempt ──────────────────────────────────────────────────────────────────

model Attempt {
  id              String        @id @default(cuid())
  assessmentId    String
  studentId       String
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  score           Float?
  percentageScore Float?
  totalFlags      Int           @default(0)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  assessment      Assessment    @relation(fields: [assessmentId], references: [id])
  student         User          @relation(fields: [studentId], references: [id])
  answers         Answer[]
  integrityEvents IntegrityEvent[]

  @@index([assessmentId])
  @@index([studentId])
  @@map("attempts")
}

// ─── Answer ───────────────────────────────────────────────────────────────────

model Answer {
  id               String    @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   String?   // MCQ: option key (A/B/C/D)
  textAnswer       String?   @db.Text
  isCorrect        Boolean?
  score            Float?
  timeTakenSeconds Int?
  createdAt        DateTime  @default(now())

  attempt          Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question  @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("answers")
}

// ─── Integrity Event ──────────────────────────────────────────────────────────

model IntegrityEvent {
  id          String             @id @default(cuid())
  attemptId   String
  eventType   IntegrityEventType
  severity    IntegritySeverity  @default(LOW)
  metadata    Json               @default("{}")
  occurredAt  DateTime           @default(now())

  attempt     Attempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
  @@map("integrity_events")
}

// ─── AI Usage Log ─────────────────────────────────────────────────────────────

model AIUsageLog {
  id              String       @id @default(cuid())
  organizationId  String?
  userId          String
  action          AIAction
  model           String       // e.g. "claude-sonnet-4-6"
  inputTokens     Int
  outputTokens    Int
  costUsd         Float
  durationMs      Int
  success         Boolean      @default(true)
  // True while a call is in flight: its reserved estimate counts toward quotas
  // until the provider's measured usage replaces it.
  pending         Boolean      @default(false)
  reservedCostUsd Float        @default(0)
  errorMessage    String?
  relatedEntityId String?      // documentId, assessmentId, etc.
  createdAt       DateTime     @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ─── Flashcard ────────────────────────────────────────────────────────────────

model Flashcard {
  id             String       @id @default(cuid())
  organizationId String?
  studentId      String
  documentId     String?
  topicId        String?
  courseId       String?
  front          String       @db.Text
  back           String       @db.Text
  // Spaced repetition (SM-2)
  dueDate        DateTime     @default(now())
  intervalDays   Int          @default(1)
  easeFactor     Float        @default(2.5)
  repetitions    Int          @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id])
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  topic          Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([courseId])
  @@index([dueDate])
  @@map("flashcards")
}

// ─── Study Availability ───────────────────────────────────────────────────────

model StudyAvailability {
  id          String   @id @default(cuid())
  studentId   String
  dayOfWeek   Int      // 0 = Sunday .. 6 = Saturday
  startTime   String   // "18:00"
  endTime     String   // "22:00"
  maxMinutes  Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation("StudyAvailabilityStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("study_availabilities")
}

// ─── Study Plan ───────────────────────────────────────────────────────────────

model StudyPlan {
  id        String          @id @default(cuid())
  studentId String
  courseId  String
  examDate  DateTime
  startDate DateTime        @default(now())
  status    StudyPlanStatus @default(ACTIVE)
  version   Int             @default(1)
  // EXAM_DATE: plan runs to examDate; DURATION: a fixed 5/10/13-week (or custom) plan ending on examDate
  planType  PlanType        @default(EXAM_DATE)
  weeks     Int?
  // [{ at, reason }] — every automatic or manual adjustment, shown to the student
  changeLog Json            @default("[]")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  student   User            @relation("StudyPlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions  StudySession[]

  @@index([studentId])
  @@index([courseId])
  @@map("study_plans")
}

// ─── Study Session ────────────────────────────────────────────────────────────

model StudySession {
  id               String              @id @default(cuid())
  studyPlanId      String
  studentId        String
  courseId         String
  topicId          String?             // null = revision/buffer session
  scheduledDate    DateTime
  startTime        String
  endTime          String
  kind             SessionKind         @default(LEARN)
  weekNumber       Int?
  // Why this session exists when it wasn't in the original plan, e.g. "Added after a 40% quiz"
  note             String?
  estimatedMinutes Int
  actualMinutes    Int?
  status           StudySessionStatus  @default(NOT_STARTED)
  confidenceRating Int?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  studyPlan        StudyPlan           @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  student          User                @relation("StudySessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic            Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studyPlanId])
  @@index([studentId])
  @@index([scheduledDate])
  @@index([studentId, completedAt])
  @@index([status])
  @@map("study_sessions")
}

// ─── Topic Mastery ────────────────────────────────────────────────────────────

model TopicMastery {
  id             String    @id @default(cuid())
  studentId      String
  topicId        String
  masteryScore   Float     @default(0)
  quizAverage    Float?
  revisionCount  Int       @default(0)
  lastAssessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student        User      @relation("TopicMasteryStudent", fields: [studentId], references: [id], onDelete: Cascade)
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([studentId])
  @@map("topic_masteries")
}

// ─── Self-quiz attempt ────────────────────────────────────────────────────────
// A graded Nightklass self-quiz; drives adaptive difficulty, mastery history and exam readiness

model SelfQuizAttempt {
  id           String             @id @default(cuid())
  studentId    String
  topicId      String
  courseId     String
  difficulty   QuestionDifficulty
  scorePercent Int
  questionCount Int
  results      Json
  createdAt    DateTime           @default(now())

  @@index([studentId, topicId])
  @@index([courseId])
  @@index([createdAt])
  @@map("self_quiz_attempts")
}

// ─── GPA Entry ────────────────────────────────────────────────────────────────

model GpaEntry {
  id            String   @id @default(cuid())
  studentId     String
  level         Int
  semester      Semester
  courseTitle   String
  creditUnits   Int
  grade         String
  scale         GpaScale
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       User     @relation("GpaEntryStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("gpa_entries")
}

// Separate from shared institutional roles: no KwikEval role grants access.
enum NightklassAdminRole {
  ADMIN
  OWNER
}

model NightklassAdmin {
  userId String @id
  role NightklassAdminRole @default(ADMIN)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("nightklass_admins")
}

model NightklassAdminAudit {
  id String @id @default(cuid())
  actorId String
  action String
  resourceType String
  resourceId String
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("nightklass_admin_audits")
}

// Standalone Nightklass exam preparation; institutional assessment tenancy is unchanged.
enum StudyPathway {
  TERTIARY
  EXAM_PREPARATION
}

enum SecondaryStage {
  SS1
  SS2
  SS3
  SCHOOL_LEAVER
}

enum ExamFamily {
  JAMB
  WAEC
}

model ExamGoal {
  series String @default("GENERAL")
  id        String @id @default(cuid())
  studentId String
  exam      ExamFamily
  year      Int
  subjects  ExamGoalSubject[]
  mockAttempts ExamMockAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, exam, year])
  @@map("exam_goals")
}

model ExamGoalSubject {
  id         String @id @default(cuid())
  goalId     String
  subjectKey String
  name       String
  courseId   String
  goal       ExamGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([goalId, subjectKey])
  @@index([courseId])
  @@map("exam_goal_subjects")
}


// Shared exam content is independent of private learner uploads and institutional records.
model ExamMaterial {
  id           String @id @default(cuid())
  exam         ExamFamily
  subject      String
  subjectKey   String
  topic        String
  title        String
  body         String @db.Text
  sourceNote   String
  // Optional class the notes are written for (SS1–SS3); shown as a label, not used to hide notes.
  classLevel   SecondaryStage?
  status       QuestionStatus @default(DRAFT)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  questions    ExamBankQuestion[]
  @@index([exam, subjectKey, status])
  @@map("exam_materials")
}

model ExamBankQuestion {
  generationJobId String?
  generationJob ExamGenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  objectiveLinks ExamQuestionObjective[]
  practiceCopies Question[]
  supersedesId String? @unique
  supersedes ExamBankQuestion? @relation("QuestionCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  correction ExamBankQuestion? @relation("QuestionCorrections")
  id           String @id @default(cuid())
  exam         ExamFamily
  subject      String
  subjectKey   String
  topic        String
  materialId   String?
  material     ExamMaterial? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  questionText String @db.Text
  questionType QuestionType
  options      Json?
  correctAnswer String @db.Text
  explanation  String @db.Text
  marks        Int @default(1)
  difficulty   QuestionDifficulty
  status       QuestionStatus @default(DRAFT)
  revision     Int @default(1)
  fingerprint  String
  isAiGenerated Boolean @default(false)
  // 1 = question stem only (legacy rows); 2 = stem plus normalized options.
  fingerprintVersion Int @default(1)
  generatorModel String?
  generatorPromptVersion String?
  exposures    ExamQuestionExposure[]
  reports      ExamQuestionReport[]
  createdById  String
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([exam, subjectKey, fingerprint])
  @@index([exam, subjectKey, status, topic])
  @@map("exam_bank_questions")
}


model ExamMockTemplate {
  id             String @id @default(cuid())
  year           Int @unique
  title          String
  durationMinutes Int
  englishCount   Int
  otherCount     Int
  instructions   String @db.Text
  sourceNote     String
  status         QuestionStatus @default(DRAFT)
  revision       Int @default(1)
  attempts       ExamMockAttempt[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("exam_mock_templates")
}

model ExamMockAttempt {
  id          String @id @default(cuid())
  studentId   String
  goalId      String
  templateId  String?
  waecPaperId String?
  waecPaper   WaecPaperTemplate? @relation(fields: [waecPaperId], references: [id], onDelete: Restrict)
  student     User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  goal        ExamGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  template    ExamMockTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestKey  String
  activeKey   String? @unique
  status      AttemptStatus @default(IN_PROGRESS)
  version     Int @default(1)
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  submissionReason String?
  specification Json
  questions   Json
  answers     Json @default("{}")
  flags       String[]
  selectedQuestions String[] @default([])
  gradingAttempts Int @default(0)
  gradingNextAt DateTime?
  gradingLeaseUntil DateTime?
  result      Json?
  @@unique([studentId, requestKey])
  @@index([status, expiresAt])
  @@index([studentId, startedAt])
  @@map("exam_mock_attempts")
}


model WaecPaperTemplate {
  id              String @id @default(cuid())
  year            Int
  series          String
  subject         String
  subjectKey      String
  paperCode       String
  title           String
  durationMinutes Int
  instructions    String @db.Text
  sourceNote      String
  sections        Json
  status          QuestionStatus @default(DRAFT)
  revision        Int @default(1)
  attempts        ExamMockAttempt[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([year, series, subjectKey, paperCode])
  @@map("waec_paper_templates")
}


model ExamSyllabus {
  id String @id @default(cuid())
  exam ExamFamily
  year Int
  subject String
  subjectKey String
  version Int
  title String
  provenance String
  sourceUrl String?
  sourceNote String
  status QuestionStatus @default(DRAFT)
  revision Int @default(1)
  reviewedById String?
  objectives ExamSyllabusObjective[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([exam, year, subjectKey, version])
  @@index([exam, year, subjectKey, status])
  @@map("exam_syllabuses")
}
model ExamSyllabusObjective {
  id String @id @default(cuid())
  syllabusId String
  syllabus ExamSyllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  code String
  title String
  description String @db.Text
  order Int
  questions ExamQuestionObjective[]
  studyLinks ExamObjectiveStudyLink[]
  @@unique([syllabusId, code])
  @@map("exam_syllabus_objectives")
}
model ExamQuestionObjective {
  questionId String
  objectiveId String
  question ExamBankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  objective ExamSyllabusObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  @@id([questionId, objectiveId])
  @@index([objectiveId])
  @@map("exam_question_objectives")
}
model ExamObjectiveStudyLink {
  studentId String
  objectiveId String
  topicId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  objective ExamSyllabusObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([studentId, objectiveId])
  @@index([topicId])
  @@map("exam_objective_study_links")
}

model ExamGenerationJob {
  id String @id @default(cuid())
  actorId String
  requestKey String
  payload Json
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAt DateTime @default(now())
  leaseUntil DateTime?
  result Json?
  error String?
  questions ExamBankQuestion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([actorId, requestKey])
  @@index([status, nextAt])
  @@map("exam_generation_jobs")
}


model ExamCalendar {
  id String @id @default(cuid())
  exam ExamFamily
  year Int
  series String
  version Int
  title String
  startDate String
  endDate String?
  sourceNote String
  status QuestionStatus @default(DRAFT)
  revision Int @default(1)
  entries Json
  fileKey String?
  fileName String?
  extractedText String? @db.Text
  reviewedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([exam,year,series,version])
  @@index([exam,year,series,status])
  @@map("exam_calendars")
}

enum EmailTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}
model EmailToken {
  id        String @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, createdAt])
  @@map("email_tokens")
}
// Operator-adjustable switches and limits (AI kill switch, budgets, exam access).
model RuntimeSetting {
  key       String @id
  value     Json
  updatedById String?
  updatedAt DateTime @updatedAt
  @@map("runtime_settings")
}
model ExamCohortMember {
  userId    String @id
  addedById String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("exam_cohort_members")
}
// Which reviewed questions a learner has been shown, for unseen-first form assembly and item statistics.
model ExamQuestionExposure {
  studentId  String
  questionId String
  timesSeen  Int @default(1)
  lastSeenAt DateTime @default(now())
  student    User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question   ExamBankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@id([studentId, questionId])
  @@index([questionId])
  @@map("exam_question_exposures")
}
model ExamQuestionReport {
  id         String @id @default(cuid())
  questionId String
  reporterId String
  attemptId  String?
  reason     String
  details    String @db.Text
  status     String @default("OPEN")
  resolutionNote String?
  resolvedById String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  question   ExamBankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporter   User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([reporterId, questionId])
  @@index([status, createdAt])
  @@map("exam_question_reports")
}
