{
  "name": "@assessiq/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build --path tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "test:watch": "vitest",
    "test:admin:integration": "npm run build && node --test test/nightklass-admin.integration.cjs",
    "test:exam:integration": "npm run build && node --test test/nightklass-exam.integration.cjs"
  },
  "dependencies": {
    "@assessiq/db": "*",
    "@assessiq/types": "*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/bull": "^10.2.1",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.8.0",
    "openai": "^7.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "file-type": "^20.4.1"
  },
  "devDependencies": {
    "@assessiq/config": "*",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
